@page "/Trabajos/Create"
@using RegistroTecnico.Components.Pages.TrabajosPages.TrabajosComponents

@inject IJSRuntime JSRuntime
@inject TrabajosService trabajosService
@inject TecnicoServices tecnicosService
@inject ClientesService clientesService
@inject ArticulosService articulosService
@inject PrioridadesService prioridadesService
@inject NavigationManager navigationManager
@rendermode InteractiveServer

<PageTitle>Trabajos Create</PageTitle>
<EditForm Model="@Trabajo" OnValidSubmit="Guardar">
	<DataAnnotationsValidator />

	<div class="container">
		<div class="card shadow-lg">
			@*HEADER*@
			<div class="card-header text-center">
				<h5><strong>Crear nuevo Trabajo</strong></h5>
			</div>

			@*BODY*@
			<div class="card-body">

				<div>
					@*Campo ID (solo lectura)*@
					<label class="form-label"><strong>ID:</strong></label>
					<InputNumber class="form-control" readonly @bind-Value="Trabajo.TrabajosId"></InputNumber>
				</div>
				<div>
					@*Campo seleccion de Prioridades*@
					<label class="form-label"><strong>Prioridad:</strong></label>
					<InputSelect class="form-select" @bind-Value="Trabajo.PrioridadId">
						<option  value="0" selected disabled>--- Seleccione una prioridad ---</option>
						@foreach (var prioridad in ListaPrioridades)
						{
							<option value="@prioridad.PrioridadesId">@prioridad.Descripcion</option>
						}
					</InputSelect>
				</div>
				<br />
				<div>
					@*Campo selccion de Cliente*@
					<label class="form-label"><strong>Cliente:</strong></label>
					<InputSelect class="form-select" @bind-Value="Trabajo.ClienteId">
						<option value="0" selected disabled >--- Seleccione un cliente ---</option>
						@foreach (var cliente in ListaClientes)
						{
							<option value="@cliente.ClienteId">@cliente.Nombres</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => Trabajo.ClienteId)" />
				</div>
				<br />
				<div>
					@*Campo selccion de Tecnico*@
					<label class="form-label"><strong>T&eacute;cnico:</strong></label>
					<InputSelect class="form-select" @bind-Value="Trabajo.TecnicoId">
						<option value="0" selected disabled>--- Seleccione un T&eacute;cnico ---</option>
						@foreach (var tecnico in ListaTecnicos)
						{
							<option value="@tecnico.TecnicoId">@tecnico.Nombres --- (@tecnico.Descripcion)</option>
						}
					</InputSelect>
					<ValidationMessage For="@(() => Trabajo.TecnicoId)" />
				</div>
				<br />
				<div>
					@*Campo Fecha*@
					<label class="form-label"><strong>Fecha:</strong></label>
					<InputDate placeholder="Nombres" class="form-control" @bind-Value="Trabajo.Fecha"></InputDate>
					<ValidationMessage For="@(() => Trabajo.Fecha)" />
				</div>
				<br/>
				<div>
					@*Campo Monto*@
					<label class="form-label"><strong>Monto:</strong></label>
					<InputNumber class="form-control" @bind-Value="Trabajo.Monto"></InputNumber>
					<ValidationMessage For="@(() => Trabajo.Monto)" />
				</div>
				<br />
				<div>
					@*Campo Descripcion*@
					<label class="form-label"><strong>Descripci&oacute;n:</strong></label>
					<InputText class="form-control" @bind-Value="Trabajo.Descripcion"></InputText>
					<ValidationMessage For="@(() => Trabajo.Descripcion)" />
				</div>

				@*Cuadrado verde*@
				<div class="border border-success p-3 mt-3">
					<div>
						<h5>Detalles de articulos utilizados</h5>
					</div>

					@*AQUI SE LLAMA EL COMPONENTE NUEVO*@
					<DetailSelect ArticuloId="@Detalle.ArticuloId"
								  Cantidad="@Detalle.Cantidad"
								  Precio="@Detalle.Precio"
								  ArticuloSeleccionado="AgregarDetalle"
								  ListaArticulos="@ListaArticulos"
								  Error="@Mensaje" />


					@*Index de los Detalles*@
					<table class="table table-sm table-hover text-center">
						<thead>
							<tr>
								<th>Articulo</th>
								<th>Cantidad</th>
								<th>Precio</th>
								<th>Remover</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var detalle in Trabajo.TrabajoDetalle)
							{
								var articulo = ListaArticulos.SingleOrDefault(a => a.ArticuloId == detalle.ArticuloId);
								<tr>
									<th>@articulo?.Descripcion</th>
									<th>@detalle.Cantidad</th>
									<th>@(detalle.Precio * detalle.Cantidad)</th>
									<th>
										<button class="btn btn-outline-danger bi bi-trash3" type="button"
												@onclick="(() => RemoverDetalle(detalle))">
										</button>
									</th>
								</tr>
							}
						</tbody>
						<tfoot>
						</tfoot>
					</table>
				</div>

			</div>

			@*FOOTER*@
			<div class="card-footer text-center">
				<a href="/Trabajos/Index" class="btn btn-primary bi bi-chevron-double-left">Volver</a>
				<button type="submit" class="btn btn-success bi bi-floppy">    Guardar</button>
			</div>
		</div>
	</div>
</EditForm>

@code {
	public List<Tecnicos> ListaTecnicos { get; set; } = [];
	public List<Clientes> ListaClientes { get; set; } = [];
	public List<Articulos> ListaArticulos { get; set; } = [];
	public List<Prioridades> ListaPrioridades { get; set; } = [];
	public Trabajos Trabajo { get; set; } = new Trabajos();
	public TrabajosDetalle Detalle { get; set; } = new TrabajosDetalle();
	public string? Mensaje { get; set; } = string.Empty;

	protected override async Task OnInitializedAsync()
	{
		ListaClientes = await clientesService.Listar(lc => true);
		ListaTecnicos = await tecnicosService.Listar(lt => true);
		ListaArticulos = await articulosService.Listar(la => true);
		ListaPrioridades = await prioridadesService.Listar(lp => true);
	}

	public async Task Guardar()
	{
		Mensaje = string.Empty;
		if (Trabajo.TrabajoDetalle.Count < 1)
		{
			Mensaje = "El detalle debe llevar al menos 1 articulo";
			return;
		}
		if (Trabajo.PrioridadId < 1)
		{
			await JSRuntime.InvokeVoidAsync("alert", "El Trabajo debe tener una prioridad!");
			return;
		}
		if (Trabajo.ClienteId < 1)
		{
			await JSRuntime.InvokeVoidAsync("alert", "El Trabajo debe tener un cliente!");
			return;
		}
		if (Trabajo.TecnicoId < 1)
		{
			await JSRuntime.InvokeVoidAsync("alert", "El Trabajo debe tener una tecnico!");
			return;
		}
		var crear = await trabajosService.Guardar(Trabajo);
		await JSRuntime.InvokeVoidAsync("alert", "El Trabajo se creo correctamente!");
		navigationManager.NavigateTo("/Trabajos/Index");
		return;
	}

	public async Task AgregarDetalle((Articulos articulo, int cantidad) selection)
	{
		var ArticuloExiste = Trabajo.TrabajoDetalle
							.FirstOrDefault(a => a.ArticuloId == selection.articulo.ArticuloId);

		if (ArticuloExiste != null)
		{
			ArticuloExiste.Cantidad += selection.cantidad;
			ArticuloExiste.Costo = selection.articulo.Costo * selection.cantidad;
			ArticuloExiste.Precio = selection.articulo.Precio * selection.cantidad;
		}
		else
		{
			var detalle = new TrabajosDetalle
				{
					ArticuloId = selection.articulo.ArticuloId,
					Cantidad = selection.cantidad,
					Costo = selection.articulo.Costo * selection.cantidad,
					Precio = selection.articulo.Precio * selection.cantidad,
				};
			Trabajo.TrabajoDetalle.Add(detalle);
			detalle = new TrabajosDetalle();
			await Task.CompletedTask;
		}
	}

	public void RemoverDetalle(TrabajosDetalle detalle)
	{
		Trabajo.TrabajoDetalle.Remove(detalle);
		Detalle.ArticuloId = detalle.ArticuloId;
		Detalle.Cantidad = detalle.Cantidad;
		Detalle.Precio = detalle.Precio;
	}
}
